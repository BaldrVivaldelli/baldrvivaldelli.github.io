---
import Base from '../layouts/Base.astro';
import Fecha from '../components/Fecha.astro';
import { notas } from '../lib/notas';
import { url } from '../lib/url';
import { SITE } from '../site';

const list = await notas();
---

<Base>
	<section class="intro">
		<h1>{SITE.name}</h1>
		<p>{SITE.description}</p>
	</section>
	<ul class="notas">
		{
			list.map((nota) => (
				<li>
					<Fecha date={nota.date} />
					<a href={url(`${nota.slug}/`)}>{nota.title}</a>
					{nota.description && <p>{nota.description}</p>}
				</li>
			))
		}
	</ul>
</Base>
